# Frontend runtime config. Copy to .env.local for development.

# Backend API base — the gateway. All client calls go through ${BASE}/api/*.
# Browser uses the public base; server components (SSR) use the internal base.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080

# Public media base (CloudFront in cloud). When set, image URLs are built as
# `${NEXT_PUBLIC_MEDIA_BASE}/${servingKey}`. Leave blank in local dev — the app then
# presigns the current user's own media via media-service and falls back to initials
# avatars for everyone else (other users' media is owner-gated and can't be presigned client-side).
NEXT_PUBLIC_MEDIA_BASE=
