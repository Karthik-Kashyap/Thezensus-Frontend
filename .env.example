# Frontend runtime config. Copy to .env.local for development.
# `node scripts/generate-auth-keys.mjs` generates the secrets marked (generated).

# ── Convex ───────────────────────────────────────────────────────────────────
# Written automatically by `npx convex dev` (along with CONVEX_DEPLOYMENT).
NEXT_PUBLIC_CONVEX_URL=

# ── App / auth (the Next.js route handlers that replaced the auth-service) ───
# App origin — OAuth redirects + cookie home. Default works for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → Credentials). Authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback   (plus the prod URL later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HS256 secret for the session / oauth-tx / signup-pending cookies. (generated)
SESSION_SECRET=

# Shared secret for the Convex authBridge functions — must equal the Convex
# deployment env var of the same name (`npx convex env set AUTH_BRIDGE_SECRET …`). (generated)
AUTH_BRIDGE_SECRET=

# RS256 signing for the Convex JWT (convex/auth.config.ts validates). (generated)
AUTH_JWT_ISSUER=https://thezensus.com
CONVEX_AUTH_KID=
CONVEX_AUTH_PRIVATE_KEY=

# ── Legacy (un-migrated domains still call the old gateway; removed by Phase 5) ─
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_INTERNAL_URL=http://localhost:8080

# Public media base (CloudFront in cloud). When set, image URLs are built as
# `${NEXT_PUBLIC_MEDIA_BASE}/${servingKey}`. Leave blank in local dev.
NEXT_PUBLIC_MEDIA_BASE=
