# Frontend runtime config. Copy to .env.local for development.

# Backend API base (via API Gateway / CloudFront in prod; local ALB or service in dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# AppSync WebSocket (live vote counts) — populated once the appsync module is applied
NEXT_PUBLIC_APPSYNC_ENDPOINT=
NEXT_PUBLIC_APPSYNC_API_KEY=

# Cognito (populated from infra outputs once the Google IdP prerequisite is met)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
